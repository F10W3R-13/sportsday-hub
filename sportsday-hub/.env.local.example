# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Drive Integration (서버 전용)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
DRIVE_ENCRYPTION_KEY=generate-64-hex-chars-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/google-callback

# 카카오톡 임박 알림 (나에게 보내기) — app/api/cron/kakao-digest
# 앱: https://developers.kakao.com — 카카오 로그인 활성화 + 동의항목 '카카오톡 메시지 전송' + Redirect URI http://localhost:5999
KAKAO_CLIENT_ID=your-kakao-app-rest-api-key
KAKAO_CLIENT_SECRET=optional-if-app-has-secret
KAKAO_REFRESH_TOKEN=your-refresh-token

# Vercel 크론 호출 인증 (임의 문자열) — 설정하면 Bearer로 검증
CRON_SECRET=your-random-secret
