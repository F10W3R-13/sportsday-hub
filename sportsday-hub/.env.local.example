# ═══════════════════════════════════════════════════════════════
#  스포츠데이 허브 — 환경변수 예시
#  실제 사용 시 이 파일을 .env.local 로 복사해 값을 채운다 (.env.local 은 git에 절대 커밋되지 않는다).
#  각 값을 구하는 방법: ../HANDOVER/01_연초_셋업.md
# ═══════════════════════════════════════════════════════════════

# ── Supabase (필수) ──
# 새 프로젝트(supabase.com) 생성 후 Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Google Drive 연동 (선택 — 파일 피드·설정 페이지 사용 시 필수) ──
# Google Cloud Console 에서 OAuth 클라이언트(ID/Secret) 발급. 절차는 HANDOVER/05.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# 드라이브 토큰 암호화 키 — 64자리 hex. 생성 예:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 한 번 정하면 바꾸지 말 것 (바꾸면 저장된 토큰 복호화 불가 → 설정 페이지에서 재연결 필요)
DRIVE_ENCRYPTION_KEY=generate-64-hex-chars-here

# 드라이브 루트 폴더 — 팀 폴더 자동매칭(auto-map)의 탐색 기준 폴더 ID (URL 끝의 문자열)
# 비워 두면 수동으로 팀별 폴더 ID를 입력해야 한다
DRIVE_ROOT_FOLDER_ID=

# OAuth 리디렉션 주소 — 배포 URL 에 맞게 수정
# (Google Cloud Console OAuth 클라이언트의 승인된 리디렉션 URI 에도 같은 값을 등록)
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/auth/google-callback

# ── 서버 전용 (드라이브 연동 사용 시 필수) ──
# Supabase Project Settings → API → service_role key. 클라이언트로 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 기타 (선택) ──
# 사이트의 대표 URL — 브라우저에서 접속하는 주소 (예: https://xxxx.vercel.app)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 데모 모드 — 1로 두면 앱의 모든 쓰기가 차단된다(전시·연출용).
# 실사용은 0 이거나 줄 자체를 지운다.
NEXT_PUBLIC_DEMO_MODE=0
